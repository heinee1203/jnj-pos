DATABASE_URL=postgresql://jnj:jnj_secret@localhost:5434/jnj_dev
# Optional. API integration tests only run when this points to an isolated DB whose name includes "test".
DATABASE_URL_TEST=postgresql://jnj:jnj_secret@localhost:5434/jnj_test
JWT_SECRET=change-me-in-production-use-a-64-char-random-string
PORT=3000
NODE_ENV=development
# Web app only. In Railway, set this to the API service public URL, e.g. https://jnj-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3000
# API app only. In Railway production, set this to the web app public URL, e.g. https://jnj-web.up.railway.app
CORS_ORIGINS=http://localhost:3011
